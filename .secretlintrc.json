{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "AWS credentials in env files",
            "filePathGlobs": ["**/.env*"],
            "pattern": "/aws_access_key_id\\s*=\\s*\\S+|aws_secret_access_key\\s*=\\s*\\S+/i"
          },
          {
            "name": "generic sensitive keys in env files",
            "filePathGlobs": ["**/.env*"],
            "pattern": "/\\b(password|passwd|pwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|private[_-]?key|database_url)\\b\\s*=\\s*\\S+/i"
          },
          {
            "name": "hardcoded sensitive values in source files",
            "filePathGlobs": ["**/*.{js,ts,json,yml,yaml,md}"],
            "pattern": "/\\b(password|passwd|pwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|private[_-]?key)\\b\\s*[:=]\\s*[\"'][^\"']+[\"']/i"
          },
          {
            "name": "private keys",
            "filePathGlobs": ["**/*.pem", "**/*.key"],
            "pattern": "/BEGIN (RSA |EC )?PRIVATE KEY/"
          }
        ]
      }
    }
  ]
}
